# /etc/rsyslog.d/60-brandvagg.conf på elev-40
# Skickar kärnloggen (brandväggens ZON-IN-DROP / ZON-UT-DROP) till loggservern
kern.* action(type="omfwd" target="172.20.1.58" port="514" protocol="tcp"
  queue.type="LinkedList" queue.filename="fwd_kern"
  queue.saveOnShutdown="on" action.resumeRetryCount="-1")
